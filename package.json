{
  "name": "n8n-nodes-resend",
  "version": "2.5.3",
  "description": "Resend integration for n8n: Email, Broadcasts, Templates, Domains, Contacts, Segments, Topics, Webhooks, Workflows, Events, and more",
  "keywords": [
    "n8n-community-node-package",
    "resend",
    "email",
    "webhook",
    "n8n",
    "automation",
    "integration",
    "broadcast",
    "template",
    "contacts"
  ],
  "license": "MIT",
  "homepage": "https://github.com/resend/n8n-nodes-resend",
  "author": {
    "name": "Resend",
    "email": "devsilkepilon@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resend/n8n-nodes-resend.git"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown && auto-changelog",
    "dev": "tsdown --watch",
    "format": "biome format --write nodes credentials",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepublishOnly": "pnpm run build && pnpm run lint",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ResendApi.credentials.js",
      "dist/credentials/ResendWebhookSigningSecretApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Resend/Resend.node.js",
      "dist/nodes/Resend/ResendTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "auto-changelog": "^2.6.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
